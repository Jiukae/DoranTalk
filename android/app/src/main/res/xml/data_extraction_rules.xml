<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12 이상: 앱 정보(로그인 등)를 클라우드 백업 · 새 휴대폰으로 옮기기에 넣지 않아요 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
